# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
# Файл .env содержит секреты — не выкладывай его никуда и не коммить.

# --- Обязательно ---
# Токен бота из https://discord.com/developers/applications → твоё приложение → Bot → Reset Token
BOT_TOKEN=вставь_сюда_токен_бота

# --- Дальше всё необязательно ---
# Любой ID ниже уже прописан в config.py как значение по умолчанию.
# Раскомментируй строку, только если нужно переопределить конкретный ID,
# не трогая код (например, для тестового сервера).

# Кто указан как контакт в сообщении на не-whitelist сервере
# FAMQ_WHITELIST_CONTACT_ID=asixez

# Серверы
# FAMQ_GUILD_ID=1466147160763666472
